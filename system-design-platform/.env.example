# Web Push (PRD Section 11/12). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Shared secrets the n8n pipeline (see n8n/.env.example) authenticates with.
# Any random string; must match on both sides.
PIPELINE_TOKEN=
NOTIFY_TOKEN=
