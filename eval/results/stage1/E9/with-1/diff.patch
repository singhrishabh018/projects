+"""Tiny admin HTTP server (health check, eligible-brands reload).
+
+Exposed through the service's load balancer, with no authentication in front of it, so
+every route here has to be safe for anyone who can reach that address to call: read-only,
+or idempotent and non-destructive like the reload below.
+"""
 import http.server
 import json
+import logging
+
+from . import config, eligibility
 
-from . import config
+log = logging.getLogger(__name__)
 
 
 def healthz():
     return 200, {"status": "ok"}
 
 
-ROUTES = {("GET", "/healthz"): healthz}
+def reload_eligible_brands():
+    """Re-read the eligible-brands export into this process.
+
+    Only the pod that serves the request is affected; prod runs several replicas behind
+    the admin Service, so this has to be called until every pod has been hit (see
+    deploy-config/runbooks/price-sync.md). On failure the pod keeps the list it already
+    had and stays healthy.
+    """
+    try:
+        previous, current = eligibility.reload()
+    except Exception as e:  # never let a bad export take down the admin thread
+        log.warning("eligible-brands reload failed: %s", e)
+        return 500, {"status": "reload failed", "error": str(e),
+                     "eligible_brands": eligibility.count()}
+    return 200, {"status": "reloaded", "eligible_brands": current, "previous": previous}
+
+
+ROUTES = {
+    ("GET", "/healthz"): healthz,
+    ("POST", "/admin/reload-eligible-brands"): reload_eligible_brands,
+}
 
 
 class Handler(http.server.BaseHTTPRequestHandler):
