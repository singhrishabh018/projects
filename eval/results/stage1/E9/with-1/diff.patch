-Loaded once when the process starts. The export is regenerated nightly by the warehouse.
+Loaded on first use and cached for the life of the process. `reload()` re-reads whatever is
+on disk right now; it does not regenerate the export, so it picks up a merchandising change
+only once that change has reached the file.
 """
 import csv
+import logging
 
 from . import config
 
+log = logging.getLogger(__name__)
+
 _eligible = None
 
 
+def _read(path):
+    with open(path, newline="") as f:
+        return {row["brand_id"] for row in csv.DictReader(f) if row.get("brand_id")}
+
+
 def load(path=None):
     global _eligible
-    with open(path or config.ELIGIBLE_BRANDS_CSV, newline="") as f:
-        _eligible = {row["brand_id"] for row in csv.DictReader(f)}
+    _eligible = _read(path or config.ELIGIBLE_BRANDS_CSV)
     return _eligible
 
 
+def reload(path=None):
+    """Re-read the export and swap it in. Returns (previous_count, new_count).
+
+    The new set is built in full before it is swapped in, so an is_eligible() call on the
+    consumer thread sees either the whole old list or the whole new one, never a partial
+    one. If the file is missing, unreadable or empty the previous list is kept and the
+    error is raised to the caller: an empty export (a half-written file, or a failed
+    warehouse job) would otherwise silently stop every price reaching the partner.
+    """
+    global _eligible
+    fresh = _read(path or config.ELIGIBLE_BRANDS_CSV)
+    if not fresh:
+        raise ValueError("eligible_brands export is empty; keeping the previous list")
+    previous = count()
+    _eligible = fresh
+    log.info("eligible brands reloaded: %d -> %d", previous, len(fresh))
+    return previous, len(fresh)
+
+
+def count():
+    return len(_eligible) if _eligible is not None else 0
+
+
 def is_eligible(brand_id):
     if _eligible is None:
         load()
