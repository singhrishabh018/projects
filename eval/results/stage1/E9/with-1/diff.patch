+import os
+import tempfile
+import unittest
+
+from price_sync import admin, config, eligibility
+
+
+class ReloadTest(unittest.TestCase):
+    def setUp(self):
+        self.path = os.path.join(tempfile.mkdtemp(), "eligible_brands.csv")
+        self._write("brand_id\nb1\n")
+        self._original_csv = config.ELIGIBLE_BRANDS_CSV
+        config.ELIGIBLE_BRANDS_CSV = self.path
+        eligibility.load(self.path)
+
+    def tearDown(self):
+        config.ELIGIBLE_BRANDS_CSV = self._original_csv
+
+    def _write(self, text):
+        with open(self.path, "w") as f:
+            f.write(text)
+
+    def test_reload_picks_up_a_rewritten_export(self):
+        self.assertFalse(eligibility.is_eligible("b2"))
+        self._write("brand_id\nb1\nb2\n")
+        status, body = admin.reload_eligible_brands()
+        self.assertEqual(status, 200)
+        self.assertEqual((body["previous"], body["eligible_brands"]), (1, 2))
+        self.assertTrue(eligibility.is_eligible("b2"))
+
+    def test_reload_drops_a_brand_that_left_the_export(self):
+        self._write("brand_id\nb2\n")
+        admin.reload_eligible_brands()
+        self.assertFalse(eligibility.is_eligible("b1"))
+
+    def test_empty_export_keeps_the_previous_list(self):
+        self._write("brand_id\n")
+        status, body = admin.reload_eligible_brands()
+        self.assertEqual(status, 500)
+        self.assertEqual(body["eligible_brands"], 1)
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+    def test_missing_export_keeps_the_previous_list(self):
+        os.remove(self.path)
+        status, _ = admin.reload_eligible_brands()
+        self.assertEqual(status, 500)
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+    def test_reload_is_not_reachable_by_get(self):
+        self.assertIn(("POST", "/admin/reload-eligible-brands"), admin.ROUTES)
+        self.assertNotIn(("GET", "/admin/reload-eligible-brands"), admin.ROUTES)
+
+    def test_healthz_still_works(self):
+        self.assertEqual(admin.healthz(), (200, {"status": "ok"}))
+
+
+if __name__ == "__main__":
+    unittest.main()


