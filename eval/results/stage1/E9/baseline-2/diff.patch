diff --git a/price-sync/tests/test_admin.py b/price-sync/tests/test_admin.py
new file mode 100644
index 0000000..19f297d
--- /dev/null
+++ b/price-sync/tests/test_admin.py
@@ -0,0 +1,62 @@
+import os
+import tempfile
+import unittest
+
+from price_sync import admin, config, consumer, eligibility
+
+
+class ReloadEligibleBrandsTest(unittest.TestCase):
+    def setUp(self):
+        self.path = os.path.join(tempfile.mkdtemp(), "eligible_brands.csv")
+        self._write("brand_id\nb1\n")
+        self._original_csv = config.ELIGIBLE_BRANDS_CSV
+        config.ELIGIBLE_BRANDS_CSV = self.path
+        eligibility.load()
+
+    def tearDown(self):
+        config.ELIGIBLE_BRANDS_CSV = self._original_csv
+
+    def _write(self, text):
+        with open(self.path, "w") as f:
+            f.write(text)
+
+    def test_route_is_registered(self):
+        self.assertIn(("POST", "/admin/reload-eligible-brands"), admin.ROUTES)
+
+    def test_reload_picks_up_a_newly_eligible_brand(self):
+        self.assertFalse(consumer.handle({"sku": "S1", "brand": "b2", "price": "9.99",
+                                          "currency": "EUR"}, send=[].append))
+        self._write("brand_id\nb1\nb2\n")
+
+        status, body = admin.reload_eligible_brands()
+
+        self.assertEqual(status, 200)
+        self.assertEqual(body["eligible_brands"], 2)
+        self.assertTrue(consumer.handle({"sku": "S1", "brand": "b2", "price": "9.99",
+                                         "currency": "EUR"}, send=[].append))
+
+    def test_reload_drops_a_brand_that_is_no_longer_eligible(self):
+        self._write("brand_id\n")
+
+        self.assertEqual(admin.reload_eligible_brands()[0], 200)
+        self.assertFalse(consumer.handle({"sku": "S1", "brand": "b1", "price": "9.99",
+                                          "currency": "EUR"}, send=[].append))
+
+    def test_failed_reload_reports_500_and_keeps_the_current_list(self):
+        os.remove(self.path)
+
+        status, body = admin.reload_eligible_brands()
+
+        self.assertEqual(status, 500)
+        self.assertEqual(body["error"], "reload failed")
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+    def test_unreadable_export_does_not_wipe_the_current_list(self):
+        self._write("not_the_expected_column\nb9\n")
+
+        self.assertEqual(admin.reload_eligible_brands()[0], 500)
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+
+if __name__ == "__main__":
+    unittest.main()


