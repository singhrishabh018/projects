-ROUTES = {("GET", "/healthz"): healthz}
+def reload_eligible_brands():
+    """Re-read the eligible_brands export so brand changes apply without a restart."""
+    try:
+        brands = eligibility.load()
+    except Exception as exc:
+        log.exception("reloading eligible brands from %s failed", config.ELIGIBLE_BRANDS_CSV)
+        return 500, {"error": "reload failed", "detail": str(exc)}
+    log.info("reloaded %d eligible brands from %s", len(brands), config.ELIGIBLE_BRANDS_CSV)
+    return 200, {"status": "reloaded", "source": config.ELIGIBLE_BRANDS_CSV,
+                 "eligible_brands": len(brands)}
+
+
+ROUTES = {
+    ("GET", "/healthz"): healthz,
+    ("POST", "/admin/reload-eligible-brands"): reload_eligible_brands,
+}
 
 
 class Handler(http.server.BaseHTTPRequestHandler):
