 """Which brands may be sent to the partner: the warehouse's eligible_brands export.
 
-Loaded once when the process starts. The export is regenerated nightly by the warehouse.
+Loaded on first use, and re-read on demand via the admin reload endpoint. The export
+itself is regenerated nightly by the warehouse.
 """
 import csv
+import logging
 
 from . import config
 
+log = logging.getLogger(__name__)
+
 _eligible = None
 
 
+def _read(path):
+    with open(path, newline="") as f:
+        return {row["brand_id"] for row in csv.DictReader(f)}
+
+
 def load(path=None):
     global _eligible
-    with open(path or config.ELIGIBLE_BRANDS_CSV, newline="") as f:
-        _eligible = {row["brand_id"] for row in csv.DictReader(f)}
+    _eligible = _read(path or config.ELIGIBLE_BRANDS_CSV)
     return _eligible
 
 
+def reload(path=None):
+    """Re-read the export and swap it in. Returns (old_count, new_count).
+
+    The new list is only swapped in once it has been read successfully, so a missing or
+    unreadable export leaves the process running on the list it already had. An export
+    with no brands is refused for the same reason: it is far more likely to be a
+    truncated or half-written file than a genuine "sell nothing online" decision, and
+    accepting it would silently stop every price going to the partner.
+    """
+    global _eligible
+    new = _read(path or config.ELIGIBLE_BRANDS_CSV)
+    if not new:
+        raise ValueError("eligible brands export is empty, keeping the current list")
+    old_count = len(_eligible) if _eligible is not None else 0
+    _eligible = new
+    log.info("reloaded eligible brands: %d -> %d", old_count, len(new))
+    return old_count, len(new)
+
+
 def is_eligible(brand_id):
     if _eligible is None:
         load()
diff --git a/price-sync/tests/test_admin.py b/price-sync/tests/test_admin.py
new file mode 100644
index 0000000..3c5f7e7
--- /dev/null
+++ b/price-sync/tests/test_admin.py
@@ -0,0 +1,68 @@
+import os
+import tempfile
+import unittest
+
+from price_sync import admin, config, consumer, eligibility
+
+
+class ReloadTest(unittest.TestCase):
+    def setUp(self):
+        self.path = os.path.join(tempfile.mkdtemp(), "eligible_brands.csv")
+        self.write("brand_id\nb1\n")
+        self._saved = config.ELIGIBLE_BRANDS_CSV
+        config.ELIGIBLE_BRANDS_CSV = self.path
+        eligibility.load(self.path)
+
+    def tearDown(self):
+        config.ELIGIBLE_BRANDS_CSV = self._saved
+
+    def write(self, text):
+        with open(self.path, "w") as f:
+            f.write(text)
+
+    def handle(self, event):
+        sent = []
+        consumer.handle(event, send=sent.append)
+        return sent
+
+    def price(self, brand):
+        return {"sku": "S1", "brand": brand, "price": "9.99", "currency": "EUR"}
+
+    def test_reload_picks_up_a_newly_eligible_brand(self):
+        self.assertEqual(self.handle(self.price("b2")), [])
+        self.write("brand_id\nb1\nb2\n")
+        status, body = admin.reload_eligible_brands()
+        self.assertEqual(status, 200)
+        self.assertEqual((body["previous_count"], body["count"]), (1, 2))
+        self.assertEqual(len(self.handle(self.price("b2"))), 1)
+
+    def test_reload_drops_a_brand_that_is_no_longer_eligible(self):
+        self.write("brand_id\nb2\n")
+        self.assertEqual(admin.reload_eligible_brands()[0], 200)
+        self.assertEqual(self.handle(self.price("b1")), [])
+
+    def test_missing_export_keeps_the_current_list(self):
+        os.remove(self.path)
+        status, body = admin.reload_eligible_brands()
+        self.assertEqual(status, 500)
+        self.assertEqual(body["status"], "error")
+        self.assertEqual(len(self.handle(self.price("b1"))), 1)
+
+    def test_empty_export_is_refused(self):
+        self.write("brand_id\n")
+        self.assertEqual(admin.reload_eligible_brands()[0], 500)
+        self.assertEqual(len(self.handle(self.price("b1"))), 1)
+
+    def test_malformed_export_keeps_the_current_list(self):
+        self.write("something_else\nb9\n")
+        self.assertEqual(admin.reload_eligible_brands()[0], 500)
+        self.assertEqual(len(self.handle(self.price("b1"))), 1)
+        self.assertEqual(self.handle(self.price("b9")), [])
+
+    def test_reload_is_not_routed_on_get(self):
+        self.assertIn(("POST", "/admin/reload-eligible-brands"), admin.ROUTES)
+        self.assertNotIn(("GET", "/admin/reload-eligible-brands"), admin.ROUTES)
+
+
+if __name__ == "__main__":
+    unittest.main()


