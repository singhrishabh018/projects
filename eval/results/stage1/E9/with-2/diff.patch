-from . import config
+from . import config, eligibility
+
+log = logging.getLogger(__name__)
 
 
 def healthz():
     return 200, {"status": "ok"}
 
 
-ROUTES = {("GET", "/healthz"): healthz}
+def reload_eligible_brands():
+    """Re-read the eligible-brands export without restarting the process.
+
+    Reports the pod that served the call and the export's timestamp: prod runs several
+    replicas behind one admin Service, and the export itself is only regenerated
+    nightly, so the caller needs both to know what actually happened.
+    """
+    pod = socket.gethostname()
+    try:
+        count, path, mtime = eligibility.reload()
+    except Exception as exc:
+        log.warning("eligible-brands reload failed on %s: %s", pod, exc)
+        return 500, {"status": "error", "pod": pod, "error": str(exc),
+                     "note": "previous eligible-brands list is still in use"}
+    exported_at = datetime.datetime.fromtimestamp(mtime, datetime.timezone.utc).isoformat()
+    log.info("reloaded %d eligible brands on %s from %s (exported %s)",
+             count, pod, path, exported_at)
+    return 200, {"status": "ok", "pod": pod, "brands": count,
+                 "source": path, "exported_at": exported_at}
+
+
+ROUTES = {
+    ("GET", "/healthz"): healthz,
+    ("POST", "/admin/reload-eligible-brands"): reload_eligible_brands,
+}
 
 
 class Handler(http.server.BaseHTTPRequestHandler):
