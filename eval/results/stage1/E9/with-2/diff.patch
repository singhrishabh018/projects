+++ b/price-sync/tests/test_admin.py
@@ -0,0 +1,74 @@
+import os
+import tempfile
+import unittest
+
+from price_sync import admin, config, eligibility
+
+
+class ReloadEligibleBrandsTest(unittest.TestCase):
+    def setUp(self):
+        self.path = os.path.join(tempfile.mkdtemp(), "eligible_brands.csv")
+        self._write("brand_id\nb1\n")
+        self._original_csv = config.ELIGIBLE_BRANDS_CSV
+        config.ELIGIBLE_BRANDS_CSV = self.path
+        eligibility.load()
+
+    def tearDown(self):
+        config.ELIGIBLE_BRANDS_CSV = self._original_csv
+
+    def _write(self, text):
+        with open(self.path, "w") as f:
+            f.write(text)
+
+    def test_reload_picks_up_a_newly_eligible_brand(self):
+        self.assertFalse(eligibility.is_eligible("b2"))
+        self._write("brand_id\nb1\nb2\n")
+
+        status, body = admin.reload_eligible_brands()
+
+        self.assertEqual(status, 200)
+        self.assertEqual(body["previous_brands"], 1)
+        self.assertEqual(body["brands"], 2)
+        self.assertTrue(eligibility.is_eligible("b2"))
+
+    def test_reload_picks_up_a_removed_brand(self):
+        self._write("brand_id\n")
+
+        status, _ = admin.reload_eligible_brands()
+
+        self.assertEqual(status, 200)
+        self.assertFalse(eligibility.is_eligible("b1"))
+
+    def test_reply_reports_the_export_timestamp_not_the_reload_time(self):
+        os.utime(self.path, (1_600_000_000, 1_600_000_000))
+
+        _, body = admin.reload_eligible_brands()
+
+        self.assertEqual(body["source_modified"], "2020-09-13T12:26:40Z")
+        self.assertNotEqual(body["source_modified"], body["loaded_at"])
+
+    def test_missing_export_keeps_the_current_list(self):
+        os.remove(self.path)
+
+        status, body = admin.reload_eligible_brands()
+
+        self.assertEqual(status, 500)
+        self.assertEqual(body["kept"]["brands"], 1)
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+    def test_unparseable_export_keeps_the_current_list(self):
+        self._write("wrong_column\nb9\n")
+
+        status, _ = admin.reload_eligible_brands()
+
+        self.assertEqual(status, 500)
+        self.assertTrue(eligibility.is_eligible("b1"))
+        self.assertFalse(eligibility.is_eligible("b9"))
+
+    def test_reload_route_is_post_only(self):
+        self.assertIn(("POST", "/reload-eligible-brands"), admin.ROUTES)
+        self.assertNotIn(("GET", "/reload-eligible-brands"), admin.ROUTES)
+
+
+if __name__ == "__main__":
+    unittest.main()


