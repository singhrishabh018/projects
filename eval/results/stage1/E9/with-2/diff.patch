 """Which brands may be sent to the partner: the warehouse's eligible_brands export.
 
-Loaded once when the process starts. The export is regenerated nightly by the warehouse.
+Loaded once when the process starts, and again on demand via the admin endpoint
+POST /admin/reload-eligible-brands. The export itself is regenerated nightly by the
+warehouse, so a reload only picks up changes the nightly job has already written.
 """
 import csv
+import os
 
 from . import config
 
 _eligible = None
+_path = None
 
 
 def load(path=None):
-    global _eligible
-    with open(path or config.ELIGIBLE_BRANDS_CSV, newline="") as f:
-        _eligible = {row["brand_id"] for row in csv.DictReader(f)}
+    """Read the export and swap it in. On any error the previous list is kept."""
+    global _eligible, _path
+    path = path or config.ELIGIBLE_BRANDS_CSV
+    with open(path, newline="") as f:
+        loaded = {row["brand_id"] for row in csv.DictReader(f)}
+    if not loaded:
+        # The nightly job writes this file in place, so a reload can catch it
+        # half-written. An empty list would silently stop every price going out.
+        raise ValueError("%s has no brands; keeping the previous list" % path)
+    _eligible, _path = loaded, path
     return _eligible
 
 
+def reload():
+    """Re-read the same export this process loaded from. Returns (count, path, mtime)."""
+    load(_path)
+    return len(_eligible), _path, os.path.getmtime(_path)
+
+
 def is_eligible(brand_id):
     if _eligible is None:
         load()
diff --git a/price-sync/tests/test_admin.py b/price-sync/tests/test_admin.py
