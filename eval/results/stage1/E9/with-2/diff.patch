     return _eligible
 
 
@@ -20,3 +35,19 @@ def is_eligible(brand_id):
     if _eligible is None:
         load()
     return brand_id in _eligible
+
+
+def status():
+    """What this process currently believes, for the admin endpoint."""
+    return {
+        "brands": len(_eligible) if _eligible is not None else 0,
+        "source": _source or config.ELIGIBLE_BRANDS_CSV,
+        "source_modified": _iso(_source_mtime),
+        "loaded_at": _iso(_loaded_at),
+    }
+
+
+def _iso(epoch):
+    if epoch is None:
+        return None
+    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))
diff --git a/price-sync/tests/test_admin.py b/price-sync/tests/test_admin.py
