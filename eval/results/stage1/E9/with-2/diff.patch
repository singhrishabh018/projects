index 0000000..fd6fe1c
--- /dev/null
+++ b/price-sync/tests/test_admin.py
@@ -0,0 +1,55 @@
+import os
+import tempfile
+import unittest
+
+from price_sync import admin, eligibility
+
+
+class ReloadEligibleBrandsTest(unittest.TestCase):
+    def setUp(self):
+        self.path = os.path.join(tempfile.mkdtemp(), "eligible_brands.csv")
+        self.write("brand_id\nb1\n")
+        eligibility.load(self.path)
+
+    def write(self, text):
+        with open(self.path, "w") as f:
+            f.write(text)
+
+    def test_reload_picks_up_a_new_brand(self):
+        self.write("brand_id\nb1\nb2\n")
+        status, body = admin.reload_eligible_brands()
+        self.assertEqual(status, 200)
+        self.assertEqual(body["brands"], 2)
+        self.assertEqual(body["source"], self.path)
+        self.assertTrue(eligibility.is_eligible("b2"))
+
+    def test_reload_drops_a_removed_brand(self):
+        self.write("brand_id\nb2\n")
+        admin.reload_eligible_brands()
+        self.assertFalse(eligibility.is_eligible("b1"))
+
+    def test_reload_reports_the_export_timestamp(self):
+        os.utime(self.path, (1_700_000_000, 1_700_000_000))
+        _, body = admin.reload_eligible_brands()
+        self.assertEqual(body["exported_at"], "2023-11-14T22:13:20+00:00")
+
+    def test_empty_export_keeps_the_previous_list(self):
+        self.write("brand_id\n")
+        status, body = admin.reload_eligible_brands()
+        self.assertEqual(status, 500)
+        self.assertIn("no brands", body["error"])
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+    def test_unreadable_export_keeps_the_previous_list(self):
+        os.remove(self.path)
+        status, _ = admin.reload_eligible_brands()
+        self.assertEqual(status, 500)
+        self.assertTrue(eligibility.is_eligible("b1"))
+
+    def test_route_is_registered_for_post_only(self):
+        self.assertIn(("POST", "/admin/reload-eligible-brands"), admin.ROUTES)
+        self.assertNotIn(("GET", "/admin/reload-eligible-brands"), admin.ROUTES)
+
+
+if __name__ == "__main__":
+    unittest.main()


