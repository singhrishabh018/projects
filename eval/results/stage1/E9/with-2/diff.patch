 """Tiny admin HTTP server (health check). Exposed through the service's load balancer."""
 import http.server
 import json
+import logging
+import socket
 
-from . import config
+from . import config, eligibility
+
+log = logging.getLogger(__name__)
 
 
 def healthz():
     return 200, {"status": "ok"}
 
 
-ROUTES = {("GET", "/healthz"): healthz}
+def reload_eligible_brands():
+    """Re-read the eligible-brands export into *this* process.
+
+    The admin Service load-balances across replicas, so one call reloads one replica. The
+    reply names the instance that handled it and the export's own timestamp, so the caller
+    can tell which pod answered and whether the file behind it is actually newer.
+    """
+    before = eligibility.status()
+    try:
+        eligibility.load()
+    except (OSError, KeyError, ValueError) as exc:
+        log.warning("eligible-brands reload failed, keeping %d brands: %s",
+                    before["brands"], exc)
+        return 500, {"status": "reload failed", "error": str(exc),
+                     "instance": socket.gethostname(), "kept": before}
+    after = eligibility.status()
+    log.info("eligible-brands reloaded: %d -> %d brands from %s",
+             before["brands"], after["brands"], after["source"])
+    return 200, {"status": "reloaded", "instance": socket.gethostname(),
+                 "previous_brands": before["brands"], **after}
+
+
+ROUTES = {
+    ("GET", "/healthz"): healthz,
+    ("POST", "/reload-eligible-brands"): reload_eligible_brands,
+}
 
 
 class Handler(http.server.BaseHTTPRequestHandler):
