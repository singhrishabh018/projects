

diff --git a/stock-sync/stock_sync/payload.py b/stock-sync/stock_sync/payload.py
index 21fbe28..9d7ee25 100644
--- a/stock-sync/stock_sync/payload.py
+++ b/stock-sync/stock_sync/payload.py
@@ -3,8 +3,14 @@ from datetime import datetime, timezone
 
 
 def build(event):
-    return {
+    item = {
         "sku": event["sku"],
         "qty": max(event["on_hand"] - event["reserved"], 0),
         "updated_at": datetime.fromtimestamp(event["ts"] / 1000, tz=timezone.utc).isoformat(),
     }
+    restock_date = event.get("restock_date")
