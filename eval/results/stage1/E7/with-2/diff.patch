

diff --git a/stock-sync/stock_sync/payload.py b/stock-sync/stock_sync/payload.py
index 21fbe28..2ebbbe5 100644
--- a/stock-sync/stock_sync/payload.py
+++ b/stock-sync/stock_sync/payload.py
@@ -3,8 +3,17 @@ from datetime import datetime, timezone
 
 
 def build(event):
-    return {
+    item = {
         "sku": event["sku"],
         "qty": max(event["on_hand"] - event["reserved"], 0),
         "updated_at": datetime.fromtimestamp(event["ts"] / 1000, tz=timezone.utc).isoformat(),
     }
+    # The partner calls this restock_eta and wants YYYY-MM-DD; our event carries epoch ms.
+    # A wrong name or wrong format is dropped silently, so map both. The field is optional:
+    # omit the key entirely rather than sending null, which would also be dropped.
+    restock_date = event.get("restock_date")
+    if restock_date is not None:
+        item["restock_eta"] = datetime.fromtimestamp(
+            restock_date / 1000, tz=timezone.utc
+        ).strftime("%Y-%m-%d")
+    return item
