+++ b/stock-sync/stock_sync/batcher.py
@@ -0,0 +1,105 @@
+"""Buffers stock updates and sends them to the partner one batch per request.
+
+The partner asks for at least `BATCH_MIN_ITEMS` items per call (tracker 131), but stock
+still has to reach them within 15 minutes of a change. Those two pull in opposite
+directions at our traffic level, so freshness wins: a batch is sent as soon as it is full
+enough *or* as soon as its oldest item reaches `BATCH_MAX_AGE_SECONDS`, whichever comes
+first. A deadline flush can therefore be shorter than the partner's preferred minimum.
+
+Ordering inside a request is not defined by the partner, so at most one item per SKU goes
+into a batch: if several events for the same SKU are buffered, only the newest is sent.
+
+Offsets must not be committed until the batch they belong to has been sent, so the caller
+hands the broker message to `add()` and this module commits it during `flush()`.
+"""
+import logging
+import time
+
+from . import brands, config, payload
+
+log = logging.getLogger(__name__)
+
+
+class _Entry:
+    __slots__ = ("event", "item", "queued_at")
+
+    def __init__(self, event, item, queued_at):
+        self.event = event
+        self.item = item
+        self.queued_at = queued_at
+
+
+class Batch:
+    """Collects items until the batch is due, then sends, marks, publishes and commits."""
+
+    def __init__(self, client, sent_log, broker, clock=time.monotonic):
+        self._client = client
+        self._sent_log = sent_log
+        self._broker = broker
+        self._clock = clock
+        self._entries = []
+        self._messages = []
+        self._oldest_at = None
+
+    def __len__(self):
+        return len(self._entries)
+
+    def add(self, event, message=None):
+        """Buffer one stock.changed event. `message` is committed when the batch is sent."""
+        if message is not None:
+            self._messages.append(message)
+        if self._oldest_at is None:
+            self._oldest_at = self._clock()
+
+        event_id = event["event_id"]
+        if self._sent_log.seen(event_id) or any(e.event["event_id"] == event_id for e in self._entries):
+            log.info("skipping already-sent event %s", event_id)
+            return False
+        self._entries.append(_Entry(event, payload.build(event), self._clock()))
+        return True
+
+    def due(self):
+        """True when the buffer should be flushed now."""
+        if not self._messages and not self._entries:
+            return False
+        if len(self._entries) >= config.BATCH_MIN_ITEMS:
+            return True
+        return self._clock() - self._oldest_at >= config.BATCH_MAX_AGE_SECONDS
+
+    def flush(self):
+        """Send everything buffered, then commit the offsets it came from."""
+        entries, messages = self._entries, self._messages
+        self._entries, self._messages, self._oldest_at = [], [], None
+
+        sent = 0
+        for chunk in _chunks(_newest_per_sku(entries), config.BATCH_MAX_ITEMS):
+            self._client.send_inventory([e.item for e in chunk])
+            for entry in chunk:
+                self._sent_log.mark(entry.event["event_id"])
+            for entry in chunk:
+                self._broker.publish("stock.sent", entry.item)
+                log.info("Stock update received and sent for %s (%s)",
+                         entry.event["sku"], brands.name(entry.event["brand"]))
+            sent += len(chunk)
+
+        for message in messages:
+            self._broker.commit(message)
+        if sent:
+            log.info("sent %d item(s) to the partner in %d request(s)",
+                     sent, -(-sent // config.BATCH_MAX_ITEMS))
+        return sent
+
+
+def _newest_per_sku(entries):
+    """One entry per SKU, newest event wins; otherwise the original buffer order."""
+    newest = {}
+    for entry in entries:
+        current = newest.get(entry.event["sku"])
+        if current is None or entry.event["ts"] >= current.event["ts"]:
+            newest[entry.event["sku"]] = entry
+    return [e for e in entries if newest.get(e.event["sku"]) is e]
+
+
+def _chunks(items, size):
+    for start in range(0, len(items), size):
+        yield items[start:start + size]
