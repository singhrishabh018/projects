diff --git a/stock-sync/tests/test_batcher.py b/stock-sync/tests/test_batcher.py
new file mode 100644
index 0000000..1c45993
--- /dev/null
+++ b/stock-sync/tests/test_batcher.py
@@ -0,0 +1,154 @@
+import os
+import tempfile
+import unittest
+
+from stock_sync import brands, config
+from stock_sync.batcher import Batch
+from stock_sync.dedup import SentLog
+from stock_sync.partner_client import PartnerClient
+from tests.fake_partner import FakePartner
+
+EVENT = {"event_id": "e1", "sku": "SKU-1", "brand": "b1", "location": "W12",
+         "on_hand": 7, "reserved": 2, "ts": 1767225600000}
+
+
+def event(n, **over):
+    return dict(EVENT, event_id="e%d" % n, sku="SKU-%d" % n, **over)
+
+
+class FakeBroker:
+    def __init__(self):
+        self.published = []
+        self.committed = []
+
+    def publish(self, topic, value):
+        self.published.append((topic, value))
+
+    def commit(self, message):
+        self.committed.append(message)
+
+
+class FakeClock:
+    def __init__(self):
+        self.now = 0.0
+
+    def __call__(self):
+        return self.now
+
+
+class BatchTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        csv_path = os.path.join(self.tmp, "brands.csv")
+        with open(csv_path, "w") as f:
+            f.write("brand_id,name,is_searchable,fulfillment_type\nb1,Acme,1,ship\n")
+        brands.load(csv_path)
+        self.partner = FakePartner()
+        self.client = PartnerClient(base_url="https://p.test", token="t", opener=self.partner)
+        self.sent_log = SentLog(os.path.join(self.tmp, "sent.db"))
+        self.broker = FakeBroker()
+        self.clock = FakeClock()
+        self.batch = Batch(self.client, self.sent_log, self.broker, clock=self.clock)
+
+    def items_of(self, request_index):
+        return self.partner.requests[request_index]["body"]["items"]
+
+    def test_single_event_is_not_sent_immediately(self):
+        self.batch.add(EVENT)
+        self.assertFalse(self.batch.due())
+        self.assertEqual(self.partner.requests, [])
+
+    def test_min_items_are_sent_in_one_request(self):
+        for n in range(config.BATCH_MIN_ITEMS):
+            self.batch.add(event(n))
+        self.assertTrue(self.batch.due())
+        self.batch.flush()
+        self.assertEqual(len(self.partner.requests), 1)
+        self.assertEqual(len(self.items_of(0)), config.BATCH_MIN_ITEMS)
+
+    def test_partial_batch_is_sent_when_deadline_passes(self):
+        self.batch.add(EVENT)
+        self.clock.now = config.BATCH_MAX_AGE_SECONDS - 1
+        self.assertFalse(self.batch.due())
+        self.clock.now = config.BATCH_MAX_AGE_SECONDS
+        self.assertTrue(self.batch.due())
+        self.batch.flush()
+        self.assertEqual(len(self.items_of(0)), 1)
+
+    def test_deadline_counts_from_the_oldest_item(self):
+        self.batch.add(event(1))
+        self.clock.now = config.BATCH_MAX_AGE_SECONDS - 1
+        self.batch.add(event(2))
+        self.clock.now = config.BATCH_MAX_AGE_SECONDS
+        self.assertTrue(self.batch.due())
+
+    def test_batch_is_split_at_max_items(self):
+        for n in range(config.BATCH_MAX_ITEMS + 5):
+            self.batch.add(event(n))
+        self.batch.flush()
+        self.assertEqual(len(self.partner.requests), 2)
+        self.assertEqual(len(self.items_of(0)), config.BATCH_MAX_ITEMS)
+        self.assertEqual(len(self.items_of(1)), 5)
+
+    def test_only_newest_event_per_sku_is_sent(self):
+        self.batch.add(dict(EVENT, event_id="e1", on_hand=7, ts=1767225600000))
+        self.batch.add(dict(EVENT, event_id="e2", on_hand=3, ts=1767225601000))
+        self.batch.flush()
+        self.assertEqual(len(self.items_of(0)), 1)
+        self.assertEqual(self.items_of(0)[0]["qty"], 1)
+
+    def test_superseding_event_wins_whatever_the_arrival_order(self):
+        self.batch.add(dict(EVENT, event_id="e2", on_hand=3, ts=1767225601000))
+        self.batch.add(dict(EVENT, event_id="e1", on_hand=7, ts=1767225600000))
+        self.batch.flush()
+        self.assertEqual(self.items_of(0)[0]["qty"], 1)
+
+    def test_redelivered_event_not_sent_twice(self):
+        self.batch.add(EVENT)
+        self.batch.flush()
+        self.batch.add(EVENT)
+        self.batch.flush()
+        self.assertEqual(len(self.partner.requests), 1)
+
+    def test_duplicate_within_one_batch_is_sent_once(self):
+        self.batch.add(EVENT)
+        self.batch.add(EVENT)
+        self.batch.flush()
+        self.assertEqual(len(self.items_of(0)), 1)
+
+    def test_publishes_every_sent_item(self):
+        self.batch.add(event(1))
+        self.batch.add(event(2))
+        self.batch.flush()
+        self.assertEqual([topic for topic, _ in self.broker.published], ["stock.sent"] * 2)
+
+    def test_offsets_are_committed_only_after_the_batch_is_sent(self):
+        self.batch.add(event(1), message="m1")
+        self.batch.add(event(2), message="m2")
+        self.assertEqual(self.broker.committed, [])
+        self.batch.flush()
+        self.assertEqual(self.broker.committed, ["m1", "m2"])
+
+    def test_skipped_duplicate_still_commits_its_offset(self):
+        self.sent_log.mark("e1")
+        self.batch.add(EVENT, message="m1")
+        self.clock.now = config.BATCH_MAX_AGE_SECONDS
+        self.assertTrue(self.batch.due())
+        self.batch.flush()
+        self.assertEqual(self.partner.requests, [])
+        self.assertEqual(self.broker.committed, ["m1"])
+
+    def test_empty_batch_is_never_due(self):
+        self.clock.now = config.BATCH_MAX_AGE_SECONDS * 10
+        self.assertFalse(self.batch.due())
+
+    def test_flush_clears_the_buffer(self):
+        self.batch.add(EVENT)
+        self.batch.flush()
+        self.batch.flush()
+        self.assertEqual(len(self.partner.requests), 1)
+        self.assertEqual(len(self.batch), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
