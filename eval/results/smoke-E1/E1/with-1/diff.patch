--- /dev/null
+++ b/stock-sync/tests/test_batcher.py
@@ -0,0 +1,178 @@
+import os
+import tempfile
+import unittest
+
+from stock_sync import payload
+from stock_sync.batcher import Batch
+from stock_sync.dedup import SentLog
+from stock_sync.partner_client import PartnerClient, PartnerError
+from tests.fake_partner import FakePartner
+
+
+def event(n):
+    return {"event_id": f"e{n}", "sku": f"SKU-{n}", "brand": "b1", "location": "W12",
+            "on_hand": 7, "reserved": 2, "ts": 1767225600000}
+
+
+class FakeBroker:
+    def __init__(self):
+        self.published = []
+        self.committed = []
+
+    def publish(self, topic, value):
+        self.published.append((topic, value))
+
+    def commit(self, message):
+        self.committed.append(message)
+
+
+class FakeClock:
+    def __init__(self):
+        self.t = 0.0
+
+    def __call__(self):
+        return self.t
+
+    def advance(self, seconds):
+        self.t += seconds
+
+
+class BatchTest(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        self.partner = FakePartner()
+        self.client = PartnerClient(base_url="https://p.test", token="t", opener=self.partner)
+        self.sent_log = SentLog(os.path.join(self.tmp, "sent.db"))
+        self.broker = FakeBroker()
+        self.clock = FakeClock()
+
+    def batch(self, **kw):
+        kw.setdefault("clock", self.clock)
+        return Batch(self.client, self.sent_log, self.broker, **kw)
+
+    def add(self, batch, n):
+        e = event(n)
+        batch.add(e["event_id"], payload.build(e), message=f"m{n}")
+
+    def items_of(self, request_index):
+        return self.partner.requests[request_index]["body"]["items"]
+
+    # R1/R2 - batches of the target size go out as a single call
+    def test_target_size_events_are_one_call(self):
+        batch = self.batch(target_size=25)
+        for n in range(25):
+            self.add(batch, n)
+        self.assertEqual(len(self.partner.requests), 1)
+        self.assertEqual(len(self.items_of(0)), 25)
+
+    def test_nothing_is_sent_before_the_target_is_reached(self):
+        batch = self.batch(target_size=25)
+        for n in range(24):
+            self.add(batch, n)
+        self.assertEqual(self.partner.requests, [])
+        self.assertEqual(len(batch), 24)
+
+    # R3 - never more than the partner's per-call maximum
+    def test_never_exceeds_max_items_per_call(self):
+        batch = self.batch(target_size=10_000, max_size=500)
+        for n in range(501):
+            self.add(batch, n)
+        self.assertEqual(len(self.items_of(0)), 500)
+        self.assertEqual(len(batch), 1)
+
+    # R4 - a part-full batch goes out when the age deadline passes
+    def test_partial_batch_flushes_on_age_deadline(self):
+        batch = self.batch(target_size=25, max_age=600)
+        for n in range(3):
+            self.add(batch, n)
+        self.clock.advance(599)
+        batch.flush_if_due()
+        self.assertEqual(self.partner.requests, [], "flushed before the deadline")
+        self.clock.advance(1)
+        batch.flush_if_due()
+        self.assertEqual(len(self.items_of(0)), 3)
+
+    def test_age_is_measured_from_the_oldest_item(self):
+        batch = self.batch(target_size=25, max_age=600)
+        self.add(batch, 1)
+        self.clock.advance(590)
+        self.add(batch, 2)          # a later arrival must not postpone the deadline
+        self.clock.advance(10)
+        batch.flush_if_due()
+        self.assertEqual(len(self.items_of(0)), 2)
+
+    def test_deadline_restarts_after_a_flush(self):
+        batch = self.batch(target_size=25, max_age=600)
+        self.add(batch, 1)
+        self.clock.advance(600)
+        batch.flush_if_due()
+        self.add(batch, 2)
+        self.clock.advance(599)
+        batch.flush_if_due()
+        self.assertEqual(len(self.partner.requests), 1)
+
+    def test_empty_batch_never_calls_the_partner(self):
+        batch = self.batch(target_size=25, max_age=600)
+        self.clock.advance(6000)
+        batch.flush_if_due()
+        batch.flush()
+        self.assertEqual(self.partner.requests, [])
+
+    # R5 - offsets, dedup and stock.sent
+    def test_offsets_are_not_committed_until_the_batch_is_sent(self):
+        batch = self.batch(target_size=25)
+        for n in range(5):
+            self.add(batch, n)
+        self.assertEqual(self.broker.committed, [], "committed before the partner call")
+        self.assertFalse(self.sent_log.seen("e0"), "marked sent before the partner call")
+        self.assertEqual(self.broker.published, [])
+        batch.flush()
+        self.assertEqual(self.broker.committed, ["m0", "m1", "m2", "m3", "m4"])
+        self.assertTrue(self.sent_log.seen("e0"))
+
+    def test_failed_flush_keeps_the_buffer_and_commits_nothing(self):
+        def boom(req, timeout=None):
+            raise OSError("partner down")
+
+        batch = Batch(self.client, self.sent_log, self.broker, target_size=25,
+                      clock=self.clock)
+        self.client._open = boom
+        for n in range(3):
+            self.add(batch, n)
+        with self.assertRaises(Exception):
+            batch.flush()
+        self.assertEqual(len(batch), 3, "buffer dropped after a failed send")
+        self.assertEqual(self.broker.committed, [])
+        self.assertFalse(self.sent_log.seen("e0"))
+
+    def test_duplicate_event_in_one_batch_is_sent_once(self):
+        batch = self.batch(target_size=25)
+        self.add(batch, 1)
+        self.add(batch, 1)
+        batch.flush()
+        self.assertEqual(len(self.items_of(0)), 1)
+
+    def test_publishes_one_stock_sent_message_per_item(self):
+        batch = self.batch(target_size=3)
+        for n in range(3):
+            self.add(batch, n)
+        self.assertEqual([topic for topic, _ in self.broker.published], ["stock.sent"] * 3)
+        # the warehouse load reads these fields off each message (load_stock_sent.sql)
+        for _, value in self.broker.published:
+            self.assertEqual(set(value), {"sku", "qty", "updated_at"})
+
+    # partner contract: assert on what the other side accepts, not on our status code
+    def test_batch_body_shape_matches_the_partner_api(self):
+        batch = self.batch(target_size=2)
+        for n in range(2):
+            self.add(batch, n)
+        body = self.partner.requests[0]["body"]
+        self.assertEqual(list(body), ["items"])
+        self.assertTrue(self.partner.requests[0]["url"].endswith("/v2/inventory"))
+        for item in body["items"]:
+            self.assertEqual(set(item), {"sku", "qty", "updated_at"})
+            self.assertIsInstance(item["qty"], int)
+
+
+if __name__ == "__main__":
+    unittest.main()
