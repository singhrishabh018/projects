+class QuietPodScenarioTest(unittest.TestCase):
+    """Overnight a pod sees ~4 events/hour, far below the partner's 25-item minimum.
+
+    The batch must still leave on the age deadline rather than wait for 25 items.
+    """
+
+    def setUp(self):
+        self.tmp = tempfile.mkdtemp()
+        self.partner = FakePartner()
+        self.client = PartnerClient(base_url="https://p.test", token="t", opener=self.partner)
+        self.sent_log = SentLog(os.path.join(self.tmp, "sent.db"))
+        self.broker = FakeBroker()
+
+    def test_two_overnight_events_reach_the_partner_within_fifteen_minutes(self):
+        now = [0.0]
+        batch = Batch(self.client, self.sent_log, self.broker, clock=lambda: now[0])
+        self.assertEqual(batch.target_size, 25)
+        self.assertLess(batch.max_age, 15 * 60, "deadline must sit inside the 15-minute promise")
+
+        for n, at in enumerate([0.0, 400.0]):          # two events in the first 7 minutes
+            now[0] = at
+            batch.add(f"e{n}", {"sku": f"SKU-{n}", "qty": 1, "updated_at": "2026-01-01T00:00:00+00:00"})
+            batch.flush_if_due()
+        self.assertEqual(self.partner.requests, [])
+
+        now[0] = 15 * 60                                # 15 minutes after the first event
+        batch.flush_if_due()
+        self.assertEqual(len(self.partner.requests), 1)
+        self.assertEqual(len(self.partner.requests[0]["body"]["items"]), 2)
+
+
+class RunModeTest(unittest.TestCase):
+    """Without an idle poll the age deadline can never fire, so run() must not batch."""
+
+    class NoPollClient:
+        def subscribe(self, topic, group):
+            return iter([])
+
+    class PollingClient(NoPollClient):
+        def poll(self, topic, group=None, timeout=None):
+            return None
+
+    def test_idle_poll_support_is_detected(self):
+        self.assertFalse(Broker(self.NoPollClient()).supports_idle_poll())
+        self.assertTrue(Broker(self.PollingClient()).supports_idle_poll())
+
+    def test_falls_back_to_unbatched_when_the_client_cannot_poll(self):
+        tmp = tempfile.mkdtemp()
+        config.SENT_LOG_PATH = os.path.join(tmp, "sent.db")
+        with self.assertLogs("stock_sync.consumer", level="ERROR") as logs:
+            consumer.run(self.NoPollClient())
+        self.assertIn("unbatched", "".join(logs.output))
+
+
