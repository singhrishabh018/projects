--- /dev/null
+++ b/stock-sync/stock_sync/batcher.py
@@ -0,0 +1,83 @@
+"""Buffers inventory items so the partner gets one call per batch instead of per event.
+
+Flushes on whichever comes first: the buffer reaches the target size, or its oldest item
+reaches the age deadline. The partner asked for >= 25 items per call *and* stock within 15
+minutes of a change; at our volume those cannot both hold (one pod per partition sees
+roughly 13 events in 15 minutes at peak), so the deadline wins and the size target is
+best-effort. See docs/partner-api.md and the tracker note.
+
+Nothing is committed or marked as sent until the partner call has succeeded: a crash with a
+full buffer must leave the events re-deliverable, not silently dropped.
+"""
+import logging
+import time
+
+from . import config
+
+log = logging.getLogger(__name__)
+
+
+class Batch:
+    def __init__(self, client, sent_log, broker, target_size=None, max_size=None,
+                 max_age=None, clock=time.monotonic):
+        self._client = client
+        self._sent_log = sent_log
+        self._broker = broker
+        self.target_size = target_size or config.BATCH_TARGET_ITEMS
+        self.max_size = max_size or config.BATCH_MAX_ITEMS
+        self.max_age = max_age if max_age is not None else config.BATCH_MAX_AGE_SECONDS
+        self._clock = clock
+        self._pending = []          # (event_id, item, message)
+        self._oldest_at = None
+
+    def __len__(self):
+        return len(self._pending)
+
+    def already_sent(self, event_id):
+        return self._sent_log.seen(event_id)
+
+    def commit(self, message):
+        """Commit a message that will never be buffered (an already-sent redelivery)."""
+        self._broker.commit(message)
+
+    def add(self, event_id, item, message=None):
+        """Buffer one item, flushing first if this one would overflow the hard cap."""
+        if any(event_id == pending_id for pending_id, _, _ in self._pending):
+            log.info("skipping duplicate event %s already buffered", event_id)
+            return
+        if len(self._pending) >= self.max_size:
+            self.flush()
+        if not self._pending:
+            self._oldest_at = self._clock()
+        self._pending.append((event_id, item, message))
+        if len(self._pending) >= min(self.target_size, self.max_size):
+            self.flush()
+
+    def age(self):
+        return 0 if self._oldest_at is None else self._clock() - self._oldest_at
+
+    def due(self):
+        return bool(self._pending) and self.age() >= self.max_age
+
+    def flush_if_due(self):
+        if self.due():
+            self.flush()
+
+    def flush(self):
+        """Send the buffer as one call, then mark, publish and commit what it contained.
+
+        On failure the buffer is kept and nothing is marked or committed, so the events are
+        still owned by this pod or, after a restart, re-delivered by the broker.
+        """
+        if not self._pending:
+            return
+        batch = self._pending
+        self._client.send_inventory([item for _, item, _ in batch])
+        self._pending = []
+        self._oldest_at = None
+        for event_id, item, message in batch:
+            self._sent_log.mark(event_id)
+            self._broker.publish("stock.sent", item)
+            if message is not None:
+                self._broker.commit(message)
+        log.info("sent %d stock updates to the partner in one call", len(batch))
diff --git a/stock-sync/stock_sync/broker.py b/stock-sync/stock_sync/broker.py
index c6ef35b..f3cc756 100644
--- a/stock-sync/stock_sync/broker.py
+++ b/stock-sync/stock_sync/broker.py
@@ -8,6 +8,19 @@ class Broker:
     def subscribe(self, topic, group):
         return self._client.subscribe(topic, group=group)
 
+    def supports_idle_poll(self):
+        """Whether the injected client can hand control back while no message is waiting.
+
+        Batching needs this: a buffer holding a few items overnight must still be flushed
+        when the age deadline passes, and `subscribe` only yields when something arrives.
+        Expected shape: `client.poll(topic, group=..., timeout=...)` returning a message,
+        or None once `timeout` seconds pass with nothing to read.
+        """
+        return callable(getattr(self._client, "poll", None))
+
+    def poll(self, topic, group, timeout):
+        return self._client.poll(topic, group=group, timeout=timeout)
+
     def commit(self, message):
         self._client.commit(message)
 
